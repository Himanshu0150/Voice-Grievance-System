PORT=5000
NODE_ENV=development

JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

DB_PATH=./database/grievance.db

UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Comma-separated list of allowed frontend origins (no trailing spaces)
CORS_ORIGIN=http://localhost:5173,https://voice-grievance-system.vercel.app

DEFAULT_ADMIN_EMAIL=admin@panchayat.gov.in
DEFAULT_ADMIN_PASSWORD=Admin@123

# SMS Gateway Configuration
# Supported providers: fast2sms (recommended), msg91, twilio, log (dev only)
SMS_PROVIDER=log
# Get your Fast2SMS API key from https://www.fast2sms.com (free credits available)
SMS_API_KEY=your_api_key_here
# Sender ID registered with your SMS provider (must be 6 characters, e.g., GVNCE)
SMS_SENDER_ID=GVNCE

# ============================================
# AI Provider Configuration
# ============================================
# Supported providers: gemini, openai
# Leave AI_API_KEY empty for development mode (uses mock classification)
AI_PROVIDER=gemini
AI_API_KEY=
# Google Gemini model (used when AI_PROVIDER=gemini)
AI_GEMINI_MODEL=gemini-2.0-flash
# OpenAI model (used when AI_PROVIDER=openai)
AI_OPENAI_MODEL=gpt-4o
# OpenAI API endpoint (change for Azure OpenAI or compatible APIs)
AI_OPENAI_ENDPOINT=https://api.openai.com/v1
