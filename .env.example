# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=7d

# Database
DB_PATH=./database/grievance.db

# Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# CORS
CORS_ORIGIN=http://localhost:5173

# Default Admin
DEFAULT_ADMIN_EMAIL=admin@panchayat.gov.in
DEFAULT_ADMIN_PASSWORD=Admin@123

# SMS Gateway Configuration
# Supported providers: fast2sms (recommended), msg91, twilio, log (dev only)
SMS_PROVIDER=fast2sms
# Get your Fast2SMS API key from https://www.fast2sms.com (free credits available)
SMS_API_KEY=kXYteVNPdGlUq1hH4ETyfQz9ZwAjO7nRJFSaguKD3B0WiI2CscgEGFnXvPdeJ1WYz4sBNbSDhCi2cq3m
# Sender ID registered with your SMS provider (must be 6 characters, e.g., GVNCE)
SMS_SENDER_ID=GVNCE
